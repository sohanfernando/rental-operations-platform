{
  "name": "rental-operations-platform",
  "private": true,
  "engines": {
    "node": ">=24.15 <25"
  },
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.5.0"
    }
  },
  "scripts": {
    "dev:api": "npm run dev --workspace @rental/api",
    "dev:web": "npm run dev --workspace @rental/web",
    "worker": "npm run worker --workspace @rental/api",
    "db:generate": "npm run db:generate --workspace @rental/api",
    "db:migrate": "npm run db:migrate --workspace @rental/api",
    "db:seed": "npm run db:seed --workspace @rental/api",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace @rental/api",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
