API_PORT=3000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
SESSION_HOURS=12
HOLD_SECONDS=900
RECONCILE_SECONDS=30
JOB_QUEUE_PREFIX=rental

# Optional development seed staff login. Set both values in .env to enable it.
DEMO_STAFF_EMAIL=
DEMO_STAFF_PASSWORD=

# Development-only credentials for the local Compose stack.
MYSQL_DATABASE=rental_operations
MYSQL_USER=rental
MYSQL_PASSWORD=local-rental-password
MYSQL_ROOT_PASSWORD=local-root-password
MYSQL_PORT=13306
DATABASE_URL=mysql://rental:local-rental-password@127.0.0.1:13306/rental_operations

REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379
